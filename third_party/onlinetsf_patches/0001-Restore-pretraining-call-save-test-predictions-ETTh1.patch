diff --git a/run_etth1.sh b/run_etth1.sh
new file mode 100755
index 0000000..7b6524a
--- /dev/null
+++ b/run_etth1.sh
@@ -0,0 +1,11 @@
+#!/bin/bash
+# ETTh1 H24, TCN-RevIN backbone (attention-free): Online (GD) and Proceed, predictions saved for the plug-in study
+cd "$(dirname "$0")"; mkdir -p preds
+until [ -f checkpoints/ETTh1_60_24_TCN_RevIN_online_ftM_sl60_ll48_pl24_lr0.003_dm512_nh8_el2_dl1_df2048_fc3_ebtimeF_dtTrue_test_0/checkpoint.pth ] && ! pgrep -f "pred_len 24 --itr 1 --only_test" >/dev/null; do sleep 30; done
+SAVE_PRED=preds/ETTh1_24_Online.npz python -u run.py --dataset ETTh1 --border_type online --model TCN --normalization RevIN \
+  --seq_len 60 --pred_len 24 --itr 1 --online_method Online --pretrain --pin_gpu False --reduce_bs False --save_opt --only_test \
+  --online_learning_rate 0.00001 > logs/online/TCN_ETTh1_24_Online.log 2>&1
+SAVE_PRED=preds/ETTh1_24_Proceed.npz python -u run.py --dataset ETTh1 --border_type online --batch_size 16 --model TCN --normalization RevIN \
+  --seq_len 60 --pred_len 24 --tune_mode down_up --val_online_lr --diff_online_lr --itr 1 --pretrain --save_opt --online_method Proceed \
+  --bottleneck_dim 32 --concept_dim 50 --online_learning_rate 0.00003 --learning_rate 0.003 --lradj type3 --pin_gpu False > logs/online/TCN_ETTh1_24_Proceed.log 2>&1
+grep -h "mse:" logs/online/TCN_ETTh1_24_Online.log logs/online/TCN_ETTh1_24_Proceed.log; echo RUN_DONE
