Subject: [PATCH 3/4] RLinear settings for ETTm2; run scripts

---
 run_rlinear_ETTm2.sh | 11 +++++++++++
 run_rlinear_etth2.sh | 11 +++++++++++
 settings.py          |  2 +-
 3 files changed, 23 insertions(+), 1 deletion(-)
 create mode 100755 run_rlinear_ETTm2.sh
 create mode 100755 run_rlinear_etth2.sh

diff --git a/run_rlinear_ETTm2.sh b/run_rlinear_ETTm2.sh
new file mode 100755
index 0000000..8e4c4d4
--- /dev/null
+++ b/run_rlinear_ETTm2.sh
@@ -0,0 +1,11 @@
+#!/bin/bash
+# Fairness check: PROCEED and Online-GD with the SAME backbone family and lookback as ours (RLinear, L = 336), ETTm2 H24
+cd "$(dirname "$0")"; mkdir -p preds
+python -u run.py --dataset ETTm2 --border_type online --model RLinear --seq_len 336 --pred_len 24 --itr 1 --only_test \
+  --pin_gpu False --reduce_bs False --save_opt --learning_rate 0.003 > logs/online/RLinear_ETTm2_24_pre.log 2>&1
+SAVE_PRED=preds/ETTm2_24_RL_Online.npz python -u run.py --dataset ETTm2 --border_type online --model RLinear --seq_len 336 --pred_len 24 \
+  --itr 1 --online_method Online --pretrain --pin_gpu False --reduce_bs False --save_opt --only_test --online_learning_rate 0.00001 > logs/online/RLinear_ETTm2_24_Online.log 2>&1
+SAVE_PRED=preds/ETTm2_24_RL_Proceed.npz python -u run.py --dataset ETTm2 --border_type online --batch_size 16 --model RLinear --seq_len 336 --pred_len 24 \
+  --tune_mode down_up --val_online_lr --diff_online_lr --itr 1 --pretrain --save_opt --online_method Proceed --bottleneck_dim 32 --concept_dim 50 \
+  --online_learning_rate 0.00003 --learning_rate 0.003 --lradj type3 --pin_gpu False > logs/online/RLinear_ETTm2_24_Proceed.log 2>&1
+grep -h "Best Valid\|mse:\|Error" logs/online/RLinear_ETTm2_24_*.log; echo RL_ETTm2_DONE
